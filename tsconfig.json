{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noUncheckedIndexedAccess": false,
    "paths": {
      "~/*": ["./src/*"],
      "@/*": ["./src/*"],
      "@ptd/*": ["./packages/*"]
    }
  }
}
